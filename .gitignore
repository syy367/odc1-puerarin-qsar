# ============================================================
# ODC1 虚拟筛选项目 — Git 忽略清单
# 原则：只提交「代码 + 数据 + 结果 + 图」，不提交环境/工具/报告/备份
# ============================================================

# ---------- 1. Python 虚拟环境（最大头，平台绑定，绝不能传） ----------
.venv/
venv/
env/
ENV/
**/site-packages/
__pycache__/
*.py[cod]
*.egg-info/
.pip/

# ---------- 2. 外部工具与二进制（exe / whl / 离线安装器） ----------
# 这些是 Windows 平台专用，体积大，无法在别人的机器直接运行
tools/

# ---------- 3. 报告类文件（用户指定不上传） ----------
# HTML 汇报（含 base64 图，体积大且是中间汇报产物）
*.html
# PDF 原文（第三方文献版权文件）
*.docx
*.pdf

# ---------- 4. 备份与临时文件 ----------
*.bak-*
*.bak
*.tmp
*.temp
*.log
~$*
*.swp

# ---------- 5. WorkBuddy 工作区与 IDE 元数据 ----------
.workbuddy/
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# ---------- 6. 中间大文件（如后续生成） ----------
*.trr
*.tpr
*.xtc
*.dcd
*.nc
*.prmtop
*.parm7
